# Isolated preview; leaves play.staragent.site and next.staragent.site untouched.
multiplayer.staragent.site {
    encode zstd gzip
    header Referrer-Policy no-referrer
    header X-Content-Type-Options nosniff
    handle /ws {
        reverse_proxy 127.0.0.1:8084
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8084
    }
    handle {
        root * /opt/staragent/multiplayer-candidate/dist
        try_files {path} /index.html
        file_server
    }
}
